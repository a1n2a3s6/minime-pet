<Window x:Class="MiniMe.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMe"
        Width="340"
        Height="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="⚡ Scan My Screen Now (Ctrl+Shift+S)" Click="MenuScanNow_Click" />
            <MenuItem Header="😈 Trigger Chaos Now">
                <MenuItem Header="Shove Window" Click="MenuChaosShove_Click" />
                <MenuItem Header="Steal Mouse" Click="MenuChaosStealMouse_Click" />
                <MenuItem Header="Shake Window" Click="MenuChaosShake_Click" />
                <MenuItem Header="Squish / Resize Window" Click="MenuChaosResize_Click" />
                <MenuItem Header="Climb Active Window" Click="MenuChaosClimb_Click" />
                <MenuItem Header="Minimize Active Window" Click="MenuChaosMinimize_Click" />
            </MenuItem>
            <MenuItem Header="🤫 Boss / Focus Mode (Ctrl+Shift+H)" Click="MenuBossMode_Click" />
            <Separator />
            <MenuItem Header="🎨 Open Skin &amp; Setup Wizard" Click="MenuWizard_Click" />
            <MenuItem Header="⚙️ Settings" Click="MenuSettings_Click" />
            <MenuItem Header="Summon to Center" Click="MenuSummon_Click" />
            <Separator />
            <MenuItem Header="❌ Exit" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Smart Interactive Speech Bubble & Floating Glass Ask Bar -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="8,0,8,4">

            <!-- Smart Interactive Speech Bubble -->
            <Grid x:Name="SpeechBubbleContainer"
                  Visibility="Collapsed"
                  MaxWidth="316"
                  Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="SpeechBubbleBorder"
                        Grid.Row="0"
                        Background="#F50C0F14"
                        BorderBrush="#10B981"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="12,9">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Category Badge + Dismiss -->
                        <Grid Margin="0,0,0,5">
                            <Border x:Name="CategoryBadge"
                                    Background="#102A22"
                                    BorderBrush="#10B981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="CategoryBadgeText"
                                           Text="💡 SUGGESTION"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#34D399" />
                            </Border>
                            <Button Content="×"
                                    Click="DismissBubbleBtn_Click"
                                    HorizontalAlignment="Right"
                                    Width="20"
                                    Height="20"
                                    FontSize="12"
                                    Background="Transparent"
                                    Foreground="#8B949E"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>

                        <!-- Main Message (RTL-aware) -->
                        <TextBlock x:Name="SpeechText"
                                   Foreground="#F3F4F6"
                                   FontFamily="Segoe UI"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   LineHeight="18" />

                        <!-- Fix / Suggestion Highlight Box with 1-Click Copy -->
                        <Border x:Name="FixHighlightBox"
                                Visibility="Collapsed"
                                Background="#161B22"
                                BorderBrush="#262D3A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6"
                                Margin="0,7,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FixSuggestionText"
                                           Grid.Column="0"
                                           Foreground="#FBBF24"
                                           FontFamily="Consolas"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button x:Name="CopyFixBtn"
                                        Grid.Column="1"
                                        Content="📋 Copy"
                                        Click="CopyFixBtn_Click"
                                        Padding="8,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EmeraldButton}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Speech Pointer Tail -->
                <Polygon x:Name="SpeechTail"
                         Grid.Row="1"
                         Points="0,0 12,0 6,8"
                         Fill="#10B981"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </Grid>

            <!-- Floating Glass "Ask About My Screen" Input Pill -->
            <Border x:Name="MiniChatPanel"
                    Visibility="Collapsed"
                    Background="#F20C0F14"
                    BorderBrush="#F59E0B"
                    BorderThickness="1.3"
                    CornerRadius="12"
                    Padding="7"
                    Width="296">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.6" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MiniChatInput"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Padding="8,5"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             KeyDown="MiniChatInput_KeyDown" />
                    <Button x:Name="MiniChatSendBtn"
                            Grid.Column="1"
                            Content="Ask"
                            Click="MiniChatSendBtn_Click"
                            Margin="6,0,0,0"
                            Padding="10,5"
                            FontSize="11.5"
                            Style="{StaticResource AmberButton}" />
                    <Button x:Name="MiniChatCloseBtn"
                            Grid.Column="2"
                            Content="×"
                            Click="MiniChatCloseBtn_Click"
                            Margin="4,0,0,0"
                            Padding="7,3"
                            FontSize="13"
                            Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Pet Sprite + Dizzy Stars Overlay -->
        <Grid x:Name="PetHost"
              Grid.Row="1"
              Width="136"
              Height="136"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp">

            <Image x:Name="PetImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,1.0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetRotateTransform" Angle="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- Animated Spinning Dizzy Stars Overlay -->
            <Canvas x:Name="DizzyStarsCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Width="136"
                    Height="52"
                    VerticalAlignment="Top">
                <Path x:Name="DizzyStar1"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#FBBF24"
                      Stroke="#0C0F14"
                      StrokeThickness="0.8" />
                <Path x:Name="DizzyStar2"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#10B981"
                      Stroke="#0C0F14"
                      StrokeThickness="0.8" />
                <Path x:Name="DizzyStar3"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#F59E0B"
                      Stroke="#0C0F14"
                      StrokeThickness="0.8" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
