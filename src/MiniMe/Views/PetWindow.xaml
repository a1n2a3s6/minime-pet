<Window x:Class="MiniMe.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMe"
        Width="290"
        Height="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Skin Setup..." Click="MenuSkinSetup_Click" />
            <MenuItem Header="Settings..." Click="MenuSettings_Click" />
            <MenuItem Header="Toggle Boss Mode (Ctrl+Shift+H)" Click="MenuBossMode_Click" />
            <MenuItem Header="Summon to Center" Click="MenuSummon_Click" />
            <Separator />
            <MenuItem Header="Exit MiniMe" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Comic Speech Bubble & Inline Chat Container -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="6,0,6,4">

            <!-- Comic Speech Bubble -->
            <Grid x:Name="SpeechBubbleContainer"
                  Visibility="Collapsed"
                  MaxWidth="260"
                  Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F212141A"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.6"
                        CornerRadius="12"
                        Padding="11,7">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
                    </Border.Effect>
                    <TextBlock x:Name="SpeechText"
                               Foreground="#F9FAFB"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- Speech Bubble Pointer Tail -->
                <Polygon Grid.Row="1"
                         Points="0,0 12,0 6,8"
                         Fill="#F59E0B"
                         HorizontalAlignment="Center"
                         Margin="0,-1,0,0" />
            </Grid>

            <!-- Inline Double-Click Mini Chat Bubble -->
            <Border x:Name="MiniChatPanel"
                    Visibility="Collapsed"
                    Background="#F512141A"
                    BorderBrush="#38BDF8"
                    BorderThickness="1.4"
                    CornerRadius="10"
                    Padding="6"
                    Width="252">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.55" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MiniChatInput"
                             Grid.Column="0"
                             Background="#0B0D12"
                             Foreground="#F9FAFB"
                             CaretBrush="#38BDF8"
                             BorderBrush="#2A2F3A"
                             BorderThickness="1"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             Padding="6,4"
                             VerticalContentAlignment="Center"
                             KeyDown="MiniChatInput_KeyDown" />
                    <Button x:Name="MiniChatSendBtn"
                            Grid.Column="1"
                            Content="Send"
                            Click="MiniChatSendBtn_Click"
                            Margin="5,0,0,0"
                            Padding="8,4"
                            FontSize="11.5"
                            Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="MiniChatCloseBtn"
                            Grid.Column="2"
                            Content="×"
                            Click="MiniChatCloseBtn_Click"
                            Margin="4,0,0,0"
                            Padding="6,2"
                            FontSize="13"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Pet Sprite + Dizzy Stars Overlay -->
        <Grid x:Name="PetHost"
              Grid.Row="1"
              Width="136"
              Height="136"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp">

            <Image x:Name="PetImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,1.0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetRotateTransform" Angle="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- Animated Spinning Dizzy Stars Overlay -->
            <Canvas x:Name="DizzyStarsCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Width="136"
                    Height="52"
                    VerticalAlignment="Top">
                <Path x:Name="DizzyStar1"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#FBBF24"
                      Stroke="#12141A"
                      StrokeThickness="0.8" />
                <Path x:Name="DizzyStar2"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#38BDF8"
                      Stroke="#12141A"
                      StrokeThickness="0.8" />
                <Path x:Name="DizzyStar3"
                      Data="M 7,0 L 9,5 L 14,5.5 L 10,9 L 11.2,14 L 7,11.2 L 2.8,14 L 4,9 L 0,5.5 L 5,5 Z"
                      Fill="#F59E0B"
                      Stroke="#12141A"
                      StrokeThickness="0.8" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
