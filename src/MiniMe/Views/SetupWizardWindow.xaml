<Window x:Class="MiniMe.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMe Pet v2.0 — Setup Wizard"
        Width="920"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimary}"
        Closing="Window_Closing">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#131720">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1E2532">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,7,7" />
                                <RectangleGeometry Rect="7,7,7,7" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBg}"
            BorderBrush="{StaticResource BorderHairline}"
            BorderThickness="1.2"
            CornerRadius="16"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <!-- Custom Draggable Chrome Header -->
            <Border Grid.Row="0"
                    Background="#0A0D12"
                    BorderBrush="{StaticResource BorderHairline}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentEmerald}" Margin="0,0,10,0">
                            <TextBlock Text="M" FontWeight="Bold" FontSize="15" Foreground="#07130E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MiniMe Pet v2.0" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="#16221C" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SETUP STUDIO" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                    <Button Content="✕"
                            Click="CloseChromeBtn_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource ChromeCloseButton}" />
                </Grid>
            </Border>

            <!-- 4-Step Progress Bar -->
            <Border Grid.Row="1"
                    Background="#0E1218"
                    BorderBrush="{StaticResource BorderHairline}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <UniformGrid Columns="4" VerticalAlignment="Center">
                    <Border x:Name="StepBadge1" Background="#10241E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock x:Name="StepLabel1" Text="1. Identity" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="StepBadge2" Background="#161B22" BorderBrush="#262D3A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="3,0">
                        <TextBlock x:Name="StepLabel2" Text="2. Skin Lab" FontSize="12" FontWeight="Medium" Foreground="#8B949E" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="StepBadge3" Background="#161B22" BorderBrush="#262D3A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="3,0">
                        <TextBlock x:Name="StepLabel3" Text="3. Vision AI" FontSize="12" FontWeight="Medium" Foreground="#8B949E" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="StepBadge4" Background="#161B22" BorderBrush="#262D3A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="6,0,0,0">
                        <TextBlock x:Name="StepLabel4" Text="4. Chaos &amp; Launch" FontSize="12" FontWeight="Medium" Foreground="#8B949E" HorizontalAlignment="Center" />
                    </Border>
                </UniformGrid>
            </Border>

            <!-- Step Content Area -->
            <Grid Grid.Row="2" Margin="24,16">

                <!-- STEP 1: Identity & Vibe -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <TextBlock Text="Give your MiniMe an identity &amp; attitude" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Pick a name, core personality, and speech language. You can tweak everything anytime."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18" />

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pet Name" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                <TextBox x:Name="PetNameTextBox" Text="MiniMe" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Speech &amp; Roast Language" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="LangArabicRadio" GroupName="WizLang" IsChecked="True" Margin="0,0,6,0" Style="{StaticResource CardRadioButton}">
                                        <TextBlock Text="Egyptian Arabic (مصري)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton x:Name="LangEnglishRadio" GroupName="WizLang" Margin="6,0,0,0" Style="{StaticResource CardRadioButton}">
                                        <TextBlock Text="English" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Choose Personality" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="PersonaTrollRadio" GroupName="WizPersona" IsChecked="True" Margin="0,0,8,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="😈 غلس مصري" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" />
                                <TextBlock Text="Egyptian Troll" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6" />
                                <TextBlock Text="Sharp Egyptian humor, catches typos &amp; bugs while roasting your procrastination." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PersonaCopilotRadio" GroupName="WizPersona" Margin="4,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="🧠 ذكي ومفيد" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" />
                                <TextBlock Text="Smart Copilot" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6" />
                                <TextBlock Text="Laser-focused on typo fixes, code diagnostics, and smart reply suggestions." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PersonaGremlinRadio" GroupName="WizPersona" Margin="8,0,0,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="🔥 فوضى كاملة" FontSize="15" FontWeight="Bold" Foreground="#F87171" />
                                <TextBlock Text="Full Gremlin" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6" />
                                <TextBlock Text="Maximum desktop mayhem — steals your mouse, shoves windows, and roasts relentlessly." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>

                <!-- STEP 2: Custom Skin Lab -->
                <Grid x:Name="Step2Panel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Prompt + Drag-Drop Upload + Sliders -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="1. Art Style &amp; AI Prompt" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="CopyPromptBtn" Content="📋 Copy Prompt" Click="CopyPromptBtn_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5" Style="{StaticResource GhostButton}" />
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="StyleChibiRadio" Content="Chibi Anime" GroupName="WizStyle" IsChecked="True" Margin="0,0,4,0" Checked="StyleRadio_Checked" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                    <RadioButton x:Name="StylePixelRadio" Content="Pixel Art" GroupName="WizStyle" Margin="2,0" Checked="StyleRadio_Checked" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                    <RadioButton x:Name="StyleCartoonRadio" Content="2D Cartoon" GroupName="WizStyle" Margin="4,0,0,0" Checked="StyleRadio_Checked" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                </UniformGrid>
                                <TextBox x:Name="PromptTextBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Drag & Drop Upload Zone -->
                        <Border x:Name="UploadDropZone"
                                Background="#11161F"
                                BorderBrush="{StaticResource AccentEmerald}"
                                BorderThickness="1.4"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10"
                                AllowDrop="True"
                                Drop="UploadDropZone_Drop"
                                DragOver="UploadDropZone_DragOver">
                            <StackPanel>
                                <TextBlock x:Name="UploadStatusText"
                                           Text="Drop a 4×2 #00FF00 Green-Screen PNG/JPG here"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="Browse PNG/JPG..." Click="BrowseSpriteBtn_Click" Margin="0,0,5,0" Padding="10,6" FontSize="12" Style="{StaticResource EmeraldButton}" />
                                    <Button Content="Use Built-In Skin" Click="UseBuiltInSkinBtn_Click" Margin="5,0,0,0" Padding="10,6" FontSize="12" Style="{StaticResource GhostButton}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Tolerance + Spill Suppression Sliders -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Chroma Key Tolerance" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="ToleranceValueText" Text="0.30" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="ToleranceSlider" Minimum="0.10" Maximum="0.60" Value="0.30" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="ChromaSlider_ValueChanged" Margin="0,3,0,8" />

                                <Grid>
                                    <TextBlock Text="Green Spill Suppression" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="SpillValueText" Text="0.75" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SpillSlider" Minimum="0.00" Maximum="1.00" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ChromaSlider_ValueChanged" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Before vs After + Clickable 8-State Animation Previewer -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BEFORE (RAW SHEET)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <Border Background="#090C10" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Height="118">
                                        <Image x:Name="BeforeSheetImage" Stretch="Uniform" Margin="4" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="AFTER (CHROMA KEYED)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,0,0,5" />
                                    <Border Background="{StaticResource CheckerboardBrush}" BorderBrush="{StaticResource AccentEmerald}" BorderThickness="1" CornerRadius="8" Height="118">
                                        <Image x:Name="AfterSheetImage" Stretch="Uniform" Margin="4" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Clickable 8-State Animation Previewer -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CheckerboardBrush}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="10" Height="186">
                                    <Grid>
                                        <Image x:Name="ActivePoseImage" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="#CC0C0F14" CornerRadius="6" Padding="8,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock x:Name="ActivePoseText" Text="Idle" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CLICK TO TEST 8 STATES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                    <UniformGrid x:Name="PoseButtonsGrid" Columns="2" Rows="4" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: Fast AI Vision Brain -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="Connect Ultra-Fast Screen Vision AI" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Captures your active window in &lt;15ms, spots typos/bugs, predicts replies, and skips unchanged screens automatically."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14" />

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <RadioButton x:Name="AiGeminiRadio" GroupName="WizAi" IsChecked="True" Margin="0,0,8,0" Checked="WizAiProvider_Checked" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="⚡ Gemini 2.5 Flash" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" />
                                <TextBlock Text="Recommended — fastest multimodal vision &amp; Arabic dialect." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AiGroqRadio" GroupName="WizAi" Margin="4,0" Checked="WizAiProvider_Checked" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="🚀 Groq Vision" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" />
                                <TextBlock Text="Llama 4 Scout 17B via Groq's ultra-low-latency API." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AiOfflineRadio" GroupName="WizAi" Margin="8,0,0,0" Checked="WizAiProvider_Checked" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="🔌 Offline Mode" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Zero API key needed — uses built-in Egyptian &amp; English quips." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="API Key" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="WizApiKeyBox" Style="{StaticResource DarkPasswordBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Model ID" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox x:Name="WizModelTextBox" Text="gemini-2.5-flash" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button x:Name="TestLatencyBtn" Content="⚡ Test Latency" Click="TestLatencyBtn_Click" Style="{StaticResource AmberButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="LatencyResultText" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentEmerald}" Margin="2,0,0,10" />

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vision Abilities" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox x:Name="WizTypoToggle" Content="✍️ Typo Catcher (Arabic &amp; English with 1-click Copy Fix)" IsChecked="True" Style="{StaticResource FluentToggle}" Margin="0,0,0,7" />
                                <CheckBox x:Name="WizBugToggle" Content="🐛 Code &amp; Error Spotter (squiggles &amp; tracebacks)" IsChecked="True" Style="{StaticResource FluentToggle}" Margin="0,0,0,7" />
                                <CheckBox x:Name="WizReplyToggle" Content="🔮 Next-Text &amp; Reply Predictor" IsChecked="True" Style="{StaticResource FluentToggle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Auto-Watch Interval" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="WatchOffRadio" Content="Off" GroupName="WizWatch" IsChecked="True" Margin="0,0,3,0" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                    <RadioButton x:Name="Watch10Radio" Content="10s" GroupName="WizWatch" Margin="2,0" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                    <RadioButton x:Name="Watch20Radio" Content="20s" GroupName="WizWatch" Margin="2,0" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                    <RadioButton x:Name="Watch45Radio" Content="45s" GroupName="WizWatch" Margin="3,0,0,0" Style="{StaticResource CardRadioButton}" FontSize="11.5" />
                                </UniformGrid>
                                <TextBlock Text="Uses 8×8 perceptual hashing so unchanged screens cost 0 API calls." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- STEP 4: Chaos Calibration & Launch -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="Calibrate Real Win32 Chaos &amp; Launch" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Every prank physically moves windows or hijacks your cursor (shake mouse or press Esc to instantly abort)."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14" />

                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <RadioButton x:Name="ChaosChillRadio" GroupName="WizChaos" Margin="0,0,8,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="😌 Chill" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" />
                                <TextBlock Text="Every ~45s — occasional playful nudges." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChaosMischievousRadio" GroupName="WizChaos" IsChecked="True" Margin="4,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="😈 Mischievous" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" />
                                <TextBlock Text="Every ~18s — lively desktop pranks &amp; climbs." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChaosGremlinRadio" GroupName="WizChaos" Margin="8,0,0,0" Style="{StaticResource CardRadioButton}">
                            <StackPanel>
                                <TextBlock Text="🔥 Full Gremlin" FontSize="14.5" FontWeight="Bold" Foreground="#F87171" />
                                <TextBlock Text="Every ~7s — non-stop chaotic desktop gremlin." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="WizMouseToggle" Content="🖱️ Mouse Hijack (260px curved steal)" IsChecked="True" Style="{StaticResource FluentToggle}" Margin="0,0,0,9" />
                                <CheckBox x:Name="WizShoveToggle" Content="💥 Window Shove &amp; Violent Shake" IsChecked="True" Style="{StaticResource FluentToggle}" Margin="0,0,0,9" />
                                <CheckBox x:Name="WizResizeToggle" Content="📐 Window Resize / Squish Prank" IsChecked="True" Style="{StaticResource FluentToggle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <CheckBox x:Name="WizClimbToggle" Content="🧗 Active Window Titlebar Climber" IsChecked="True" Style="{StaticResource FluentToggle}" Margin="0,0,0,9" />
                                <CheckBox x:Name="WizMinimizeToggle" Content="🙈 Sneaky Minimize (off by default)" IsChecked="False" Style="{StaticResource FluentToggle}" Margin="0,0,0,9" />
                                <CheckBox x:Name="WizUnmaxToggle" Content="⚡ Unmaximize Prank (Full Gremlin)" IsChecked="False" Style="{StaticResource FluentToggle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Global Hotkey Reference -->
                    <Border Background="#101720" BorderBrush="#262D3A" BorderThickness="1" CornerRadius="10" Padding="12">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1E2530" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="Ctrl + Shift + S" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                                <TextBlock Text="Instant Screen Vision Scan" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1E2530" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="Ctrl + Shift + H" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Border>
                                <TextBlock Text="Boss / Focus Mode (Instant Hide)" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer Navigation -->
            <Border Grid.Row="3"
                    Background="#0A0D12"
                    BorderBrush="{StaticResource BorderHairline}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Button x:Name="BackBtn"
                            Content="← Back"
                            Click="BackBtn_Click"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Style="{StaticResource GhostButton}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NextBtn"
                                Content="Next Step →"
                                Click="NextBtn_Click"
                                Style="{StaticResource EmeraldButton}" />
                        <Button x:Name="LaunchBtn"
                                Content="🚀 Launch MiniMe"
                                Click="LaunchBtn_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource AmberButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
