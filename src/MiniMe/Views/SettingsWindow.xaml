<Window x:Class="MiniMe.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMe — Settings"
        Width="560"
        Height="680"
        MinWidth="520"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="MiniMe Settings" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Tune chaos behaviors, Egyptian Arabic / English quips, and optional Gemini or Groq AI mode."
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Chaos & Desktop Interactions -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Desktop Behavior &amp; Chaos Mode"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentAmber}"
                                   Margin="0,0,0,12" />

                        <CheckBox x:Name="WindowClimberToggle"
                                  Content="Window Climber (hops onto open titlebars and watches you work)"
                                  Style="{StaticResource FluentToggle}"
                                  Margin="0,0,0,10" />

                        <CheckBox x:Name="WindowPusherToggle"
                                  Content="Window Pusher (smoothly shoves/shakes non-maximized windows)"
                                  Style="{StaticResource FluentToggle}"
                                  Margin="0,0,0,10" />

                        <CheckBox x:Name="MouseThiefToggle"
                                  Content="Mouse Thief (runs to cursor, pulls it 120px away, laughs)"
                                  Style="{StaticResource FluentToggle}"
                                  Margin="0,0,0,10" />

                        <CheckBox x:Name="SneakyMinimizerToggle"
                                  Content="Sneaky Minimizer (rarely minimizes a window — off by default)"
                                  Style="{StaticResource FluentToggle}"
                                  Margin="0,0,0,14" />

                        <Grid>
                            <TextBlock Text="Pet Size Scale" FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="ScaleValueText"
                                       Text="1.0×"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCyan}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="PetScaleSlider"
                                Minimum="0.60"
                                Maximum="1.60"
                                TickFrequency="0.10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="PetScaleSlider_ValueChanged"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Personality & Language -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Personality &amp; Quips"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyan}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Quip Language" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <RadioButton x:Name="LangArabicRadio"
                                         Content="Egyptian Arabic (مصري)"
                                         GroupName="QuipLang"
                                         Margin="0,0,6,0"
                                         Style="{StaticResource StylePillRadio}" />
                            <RadioButton x:Name="LangEnglishRadio"
                                         Content="English"
                                         GroupName="QuipLang"
                                         Margin="6,0,0,0"
                                         Style="{StaticResource StylePillRadio}" />
                        </UniformGrid>

                        <Grid>
                            <TextBlock Text="Context Quip Interval" FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="FreqValueText"
                                       Text="30s"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAmber}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="FrequencySlider"
                                Minimum="15"
                                Maximum="90"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="FrequencySlider_ValueChanged"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Optional Online AI Brain -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Optional Online AI Brain (Roasts + Double-Click Chat)"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentAmber}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="AI Provider" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <RadioButton x:Name="AiNoneRadio"
                                         Content="Offline Only"
                                         GroupName="AiProviderGroup"
                                         Margin="0,0,6,0"
                                         Checked="AiProviderRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                            <RadioButton x:Name="AiGeminiRadio"
                                         Content="Gemini Flash"
                                         GroupName="AiProviderGroup"
                                         Margin="3,0,3,0"
                                         Checked="AiProviderRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                            <RadioButton x:Name="AiGroqRadio"
                                         Content="Groq"
                                         GroupName="AiProviderGroup"
                                         Margin="6,0,0,0"
                                         Checked="AiProviderRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                        </UniformGrid>

                        <TextBlock Text="API Key (stored locally in %AppData%\MiniMe\settings.json)"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,5" />
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Style="{StaticResource DarkPasswordBox}"
                                     Margin="0,0,0,10" />

                        <TextBlock Text="Model Name"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,5" />
                        <ComboBox x:Name="ModelComboBox"
                                  IsEditable="True"
                                  Height="34"
                                  FontSize="13"
                                  Padding="8,5" />
                    </StackPanel>
                </Border>

                <!-- Boss / Focus Mode Info -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Boss / Focus Mode — Global Shortcut: Ctrl + Shift + H"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Instantly hides MiniMe and disables all chaos actions during calls or presentations."
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="BossModeBtn"
                                Grid.Column="1"
                                Content="Toggle Boss Mode"
                                Click="BossModeBtn_Click"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="CancelBtn_Click"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="Save Settings"
                    Click="SaveBtn_Click"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
