<Window x:Class="MiniMe.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMe — Skin Studio"
        Width="860"
        Height="720"
        MinWidth="780"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Transparency Checkerboard Brush for Chroma Key Preview -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#181C24">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#232936">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="MiniMe Skin Studio"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="Generate a 4×2 green-screen sprite sheet from your photo, key out #00FF00 cleanly, and activate it live."
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Main Scrollable 3-Step Wizard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- STEP 1: Style & AI Prompt -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentAmber}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock Text="STEP 1" FontSize="11" FontWeight="Bold" Foreground="#12141A" />
                            </Border>
                            <TextBlock Text="Pick Art Style &amp; Copy AI Prompt"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <RadioButton x:Name="StyleChibiRadio"
                                         Content="Chibi Anime"
                                         GroupName="ArtStyle"
                                         IsChecked="True"
                                         Margin="0,0,8,0"
                                         Checked="StyleRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                            <RadioButton x:Name="StylePixelRadio"
                                         Content="Pixel Art"
                                         GroupName="ArtStyle"
                                         Margin="4,0,4,0"
                                         Checked="StyleRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                            <RadioButton x:Name="StyleCartoonRadio"
                                         Content="2D Cartoon"
                                         GroupName="ArtStyle"
                                         Margin="8,0,0,0"
                                         Checked="StyleRadio_Checked"
                                         Style="{StaticResource StylePillRadio}" />
                        </UniformGrid>

                        <TextBox x:Name="PromptTextBox"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Height="96"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CopyStatusText"
                                       Foreground="{StaticResource AccentCyan}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="CopyPromptBtn"
                                    Content="Copy Prompt"
                                    Click="CopyPromptBtn_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- STEP 2: Upload & Live Chroma Key Preview -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentCyan}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock Text="STEP 2" FontSize="11" FontWeight="Bold" Foreground="#12141A" />
                            </Border>
                            <TextBlock Text="Upload 4×2 Sprite Sheet &amp; Tune Chroma Key"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BrowseImageBtn"
                                    Grid.Column="0"
                                    Content="Upload PNG / JPG..."
                                    Click="BrowseImageBtn_Click"
                                    Style="{StaticResource PrimaryButton}" />

                            <TextBlock x:Name="SelectedFileText"
                                       Grid.Column="1"
                                       Text="Showing built-in procedural Chibi (upload a 4×2 green-screen PNG/JPG to customize)"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Green-Screen Tolerance" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="ToleranceValueText"
                                               Text="0.30"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentAmber}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="ToleranceSlider"
                                        Minimum="0.10"
                                        Maximum="0.60"
                                        Value="0.30"
                                        TickFrequency="0.02"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ToleranceSlider_ValueChanged"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Side-by-Side Live Animated Preview + 4x2 Sliced Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Live Animated Preview -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource CheckerboardBrush}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="148" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="LIVE PREVIEW"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}"
                                               HorizontalAlignment="Center" />
                                    <Image x:Name="AnimatedPreviewImage"
                                           Grid.Row="1"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="4" />
                                    <TextBlock x:Name="AnimatedPoseLabel"
                                               Grid.Row="2"
                                               Text="0: Idle"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 8-Frame 4x2 Sliced Grid -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">
                                <UniformGrid x:Name="SlicedFramesGrid" Columns="4" Rows="2" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STEP 3: Save & Activate -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="{StaticResource AccentAmber}" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                <TextBlock Text="STEP 3" FontSize="11" FontWeight="Bold" Foreground="#12141A" />
                            </Border>
                            <TextBlock Text="Skin Name:" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox x:Name="SkinNameTextBox"
                                 Grid.Column="1"
                                 Text="MyCustomMiniMe"
                                 Style="{StaticResource DarkTextBox}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0" />

                        <Button x:Name="ResetDefaultBtn"
                                Grid.Column="2"
                                Content="Use Built-In Chibi"
                                Click="ResetDefaultBtn_Click"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" />

                        <Button x:Name="SaveActivateBtn"
                                Grid.Column="3"
                                Content="Save &amp; Activate Skin"
                                Click="SaveActivateBtn_Click"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Status -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatusText"
                       Text="Skins are saved cleanly to %AppData%\MiniMe\skins\"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Click="CloseBtn_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
